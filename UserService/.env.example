# UserService environment variables
# Copy to .env and set appropriate values. Do NOT commit real secrets.

# Secret key used to sign access tokens (set in production)
USERSERVICE_SECRET=change_this_in_production

# Token expiration (minutes). Default: 60
USERSERVICE_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS allowed origins for production (comma-separated). Example: https://app.example.com,https://admin.example.com
# Not used directly in code; add wiring as needed.
USERSERVICE_CORS_ORIGINS=
